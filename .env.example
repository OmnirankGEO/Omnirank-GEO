# ============================================
# OmniRank AI 环境变量配置（唯一密钥来源）
# ============================================
# 使用方法：复制为 .env 并填入实际值
# Docker 部署时：docker compose 自动加载此文件
# 所有 API Key 统一在此管理，settings.json 不再存储密钥
# ============================================

# ========== LLM 服务商 API Key ==========
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
KIMI_API_KEY=your_kimi_api_key_here
HY3_API_KEY=your_tencent_tokenhub_hy3_api_key_here
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# ========== Doubao (火山引擎) ==========
DOUBAO_API_KEY=your_doubao_api_key_here
DOUBAO_ENDPOINT_ID=your_doubao_endpoint_id_here
DOUBAO_SEED_API_KEY=your_doubao_seed_api_key_here

# ========== 数据服务 API Key ==========
TIKHUB_API_KEY=your_tikhub_api_key_here
METASO_API_KEY=your_metaso_api_key_here
API_5118_LONGTAIL_KEY=your_5118_longtail_key_here
API_5118_SEARCH_VOLUME_KEY=your_5118_search_volume_key_here

# ========== 视频号 ASR(evil0ctal/wechat-decrypt-api 容器) ==========
# Deploy-CTO docker-compose 起 wx-decrypt service · 仅 localhost · 不暴露公网
# 仅前 128KB 加密 · 后端调 /api/keystream 拿 keystream 后本地 XOR(无 dependency)
WECHAT_DECRYPT_API_URL=http://wx-decrypt:3000

# ========== PostgreSQL ==========
# Docker Compose 会在容器内覆盖 DATABASE_URL 为 db:5432
# 本地开发时用 localhost:5433（映射到容器5432）
DATABASE_URL=postgresql://geo_admin:your_db_password@localhost:5433/geo_agentscope
# Internal settlement principal for customers without a commercial binding.
# Deploy creates and validates this service account; never expose it in public DTOs.
# PLATFORM_DIRECT_SERVICE_USER_ID=
POSTGRES_PASSWORD=your_secure_password_here

# ========== Redis ==========
# Docker Compose 会在容器内覆盖为 redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ========== Docker 部署配置（可选）==========
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# [WORKERS=4 · SPEC §5/D4 · 2026-07-13] 旧"强制 WORKERS=1"已被跨 worker 进度总线(Redis pubsub+快照)取代。
#   - 保守默认仍 1。要开多 worker:同时设 WORKERS=4 且 PROGRESS_BUS_READY=1(否则 start.sh / deploy gate 回退 1)。
#   - PROGRESS_BUS_READY=1 表示"已确认跨 worker 进度/状态/限流/选主全走 Redis 总线,可安全多开"。
#   - cron 由专用 ROLE=cron 容器(WORKERS=1)承担;web 容器 ROLE=web 不跑 cron(见 docker-compose omnirank-cron-*)。
WORKERS=1
# PROGRESS_BUS_READY=1   # 取消注释 + WORKERS=4 才真正启用多 worker
# JWT signing secret. Production must set this explicitly.
# To avoid invalidating existing sessions during migration, set this to the
# current container value from /app/data/jwt_secret.key before first restart.
# JWT_SECRET=replace_with_64_hex_or_long_random_secret
# Initial password of the built-in "admin" account, used only when an empty database is initialised
# (at least 12 characters). Leave empty to have a random one generated and printed once in the prestart output.
# ADMIN_INITIAL_PASSWORD=

# ========== 站点对外地址 ==========
# 你的站点给外部访问的地址,形如 https://geo.example.com(不带结尾斜杠)。
# 诊断报告分享链接、注册短链、发布文章里的图片绝对地址、支付回调的缺省地址都用它。
# 不填 = http://127.0.0.1:8001,这些链接只有本机能打开;对外服务前一定要填。
# PUBLIC_BASE_URL=

# ========== 虎皮椒聚合支付（微信通道）==========
# 从虎皮椒后台获取: https://www.xunhupay.com/
# APPSECRET 是高敏感凭据，绝不要提交到版本控制
XUNHUPAY_APPID=your_xunhupay_appid_here
XUNHUPAY_APPSECRET=your_xunhupay_appsecret_here
XUNHUPAY_GATEWAY=https://api.xunhupay.com/payment/do.html
# 回调与支付后跳转地址:不填按 PUBLIC_BASE_URL + 路径(/api/wallet/xunhupay-callback、/wallet?payment=success)
# XUNHUPAY_NOTIFY_URL=
# XUNHUPAY_RETURN_URL=

# ========== 微信支付 V3 直连 ==========
WX_MCH_ID=your_wx_mch_id
WX_APPID=your_wx_appid
# 支付 / 退款回调地址:不填按 PUBLIC_BASE_URL + 路径(/api/wallet/wechat-callback、/api/wallet/wechat-refund-callback)
# WX_NOTIFY_URL=
# WX_REFUND_NOTIFY_URL=
# 高敏感(绝不提交到版本控制):
# WX_APIV3_KEY=                    # API v3 密钥 32 位(微信支付商户后台 → API 安全 → APIv3 密钥)
# WX_SERIAL_NO=                    # 商户证书序列号
# WX_PUB_KEY_ID=                   # 微信支付公钥 ID(不是平台证书)
# WX_APP_SECRET=                   # 服务号 AppSecret(公众号后台 → 设置基本配置 · JSAPI 网页授权必需)
# 证书文件路径(.pem 挂进容器):
WX_KEY_PATH=/app/apiclient_key.pem    # 商户私钥
WX_PUB_KEY_PATH=/app/pub_key.pem      # 微信支付公钥
# 部署提醒:
#   1. apiclient_key.pem + pub_key.pem 不能 commit(.gitignore 已挡 *.pem)
#   2. 部署时把 .pem 放到服务器上,再用 docker-compose 的 volume 挂进容器
#   3. 公众号后台"网页授权域名"加你自己的站点域名(JSAPI 必需)
#   4. 微信支付商户后台"JSAPI 支付授权目录"配成你自己的站点地址

# ========== CDN (可选) ==========
# 前端静态资源 CDN 域名，留空则从服务器本地提供
# VITE_CDN_URL=https://cdn.yourdomain.com/
# OSS_BUCKET=omnirank-static
# OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com

# ========== 阿里云 OSS · 私有 bucket(KYC + 发布截图)==========
# RAM 子账号 omnirank-kyc 的 AccessKey · 已有 AliyunOSSFullAccess 权限
# (覆盖 omnirank-kyc + omnirank-publish-evidence 两个 bucket)
# OSS_ACCESS_KEY_ID=                          # 子账号 AccessKey ID
# OSS_ACCESS_KEY_SECRET=                      # 子账号 AccessKey Secret
# KYC bucket(身份证照片 · 已有)
OSS_KYC_BUCKET=omnirank-kyc
OSS_KYC_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
# 发布截图 bucket(CORS 要允许你自己的站点域名)
OSS_PUBLISH_BUCKET=omnirank-publish-evidence
OSS_PUBLISH_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
# GEO evidence-first content policy. Enabled by default in code; set false only
# for an emergency rollback after recording the reason and rollback window.
GEO_EVIDENCE_FIRST_ENABLED=true
# Staged rollout controls. Keep both off until the v1.4 schema and canary
# readiness gates have passed in the target environment.
GEO_ARTICLE_EVIDENCE_RESEARCH_ENABLED=false
GEO_ARTICLE_PUBLICATION_REVIEW_GATE_ENABLED=false

# 监测数据清除二次确认口令。生产必须由 secret store 注入；未配置时端点
# 返回 503 fail-closed。禁止把真实值写入仓库、compose 或镜像。
# MONITORING_CLEAR_DATA_PASSWORD=

# 品牌合并二次确认口令(server.py: api_brands_merge)。生产必须由 secret store 注入;
# **无默认值** —— 未配置时端点返回 503 ADMIN_MERGE_PASSWORD_NOT_CONFIGURED(fail-closed)。
# 禁止把真实值写入仓库、compose 或镜像。键名已登记在 config/required_env_keys.txt。
# ADMIN_MERGE_PASSWORD=

# 大屏密码仅保存 PBKDF2-HMAC-SHA256 结果，由 secret store 注入。迁移期旧哈希也
# 不得硬编码进源码；legacy 开关默认关闭，启用时必须同时配置 legacy hash。
# TV_ACCESS_PASSWORD_HASH=
TV_ACCESS_PASSWORD_LEGACY_ENABLED=false
# TV_ACCESS_PASSWORD_LEGACY_HASH=

# GEO article quote -> writing -> publish compatible sidecar.  Deploying the
# additive schema alone must not create plans, topics, LLM calls or charges.
ARTICLE_PLAN_READ_SUMMARY_ENABLED=false
ARTICLE_PLAN_EVENT_OUTBOX_ENABLED=false
ARTICLE_PLAN_RECONCILER_ENABLED=false
ARTICLE_PLAN_SHADOW_ENABLED=false
ARTICLE_PLAN_ADMIN_DIFF_UI_ENABLED=false
ARTICLE_WRITING_SIMPLE_UI_ENABLED=false
ARTICLE_PLAN_ASSISTED_METADATA_ENABLED=false
ARTICLE_PLAN_CANARY_UPSERT_ENABLED=false
# ARTICLE_PLAN_CANARY_ALLOWLIST=
ARTICLE_REVIEW_SHADOW_ENABLED=false
ARTICLE_FLYWHEEL_CANDIDATE_ENABLED=false
ARTICLE_FLYWHEEL_PROMOTION_ENABLED=false
# ========== 短视频（媒介盒子渠道）· 上传闸与发布闸分离，默认全关 ==========
# 🔴 两个闸是**分离**的，可以只开上传做联调而不产生任何订单/扣费：
#   MHZ_SVIDEO_UPLOAD_ENABLED  = 允许把视频/封面传上去（不下单、不扣费）
#   MHZ_SVIDEO_PUBLISH_ENABLED = 允许真实下单（**会真扣钱**，开之前想清楚）
# 取值 1/true/yes/on 为开，其余为关（含未设置）。
# [2026-08-01] 视频上传已改为「浏览器 → 我方服务器 → 对方存储」的服务端中转，
#   不再依赖对方给我们的域加 CORS 白名单。该路由在 nginx 里有独立 location
#   （client_max_body_size 1100M + proxy_request_buffering off），改 nginx.conf 后
#   必须重新构建镜像才生效（Dockerfile 是 COPY 进去的，不是挂载）。
MHZ_SVIDEO_UPLOAD_ENABLED=0
MHZ_SVIDEO_PUBLISH_ENABLED=0

# ========== 内部团队与员工邀请（默认全关闭） ==========
# 开启顺序：先迁移并发布 operational 基础席位策略，再开 seats；邀请开户需单独开关。
# 额外付费席位未签发，代码固定 fail-closed；disabled 不会发送短信或邮件。
ORGANIZATION_SEATS_ENABLED=false
ORGANIZATION_INVITE_ONBOARDING_ENABLED=false
ORGANIZATION_SHARED_PAYER_ENABLED=false
ORGANIZATION_EXTERNAL_ACTIONS_ENABLED=false
ORGANIZATION_INVITE_DELIVERY_PROVIDER=disabled
# 本地真 PG / Playwright 可使用 local_capture；production/prod 环境会拒绝该 provider。
# ORGANIZATION_INVITE_DELIVERY_PROVIDER=local_capture
# 正式短信通道：阿里云。需要 ALIBABA_CLOUD_ACCESS_KEY_ID / ALIBABA_CLOUD_ACCESS_KEY_SECRET
# 与 SMS_SIGN_NAME（与登录短信共用账号和签名）；邀请验证码使用独立模板，不复用登录模板。
# ORGANIZATION_INVITE_DELIVERY_PROVIDER=aliyun_sms
# 邀请验证码模板（模板变量 {"code":"123456"}；勿复用 SMS_TEMPLATE_CODE 登录模板）
# SMS_TEMPLATE_INVITE=SMS_xxxxxxxxx
# 邀请链接短信模板（模板变量 {"url":"https://.../organization/invite#token=..."}）
# SMS_TEMPLATE_INVITE_LINK=SMS_xxxxxxxxx
# 邀请链接短信的公开链接前缀（员工短信里收到的链接入口）
# ORGANIZATION_INVITE_LINK_BASE_URL=https://app.example.com
# 密钥格式：version:base64(至少 32 bytes)，活动版本必须单独指定；不得提交真实密钥。
# ORGANIZATION_INVITE_HMAC_KEYS=v1:<base64-secret>
# ORGANIZATION_INVITE_HMAC_KEYS_ACTIVE_VERSION=v1
# ORGANIZATION_INVITE_ENCRYPTION_KEYS=v1:<base64-secret>
# ORGANIZATION_INVITE_ENCRYPTION_KEYS_ACTIVE_VERSION=v1
# ORGANIZATION_TOKEN_HMAC_KEYS=v1:<base64-secret>
# ORGANIZATION_TOKEN_HMAC_KEYS_ACTIVE_VERSION=v1


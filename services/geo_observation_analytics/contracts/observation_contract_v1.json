    "research": "research_round",
    "paid_diagnosis": "paid_diagnosis",
    "monitoring": "recurring_monitoring"
  },
  "surface_keys": [
    "doubao_ark_api_search",
    "qwen_dashscope_search",
    "deepseek_native_no_search",
    "deepseek_native_with_search",
    "deepseek_metaso_proxy",
    "deepseek_dashscope_search_legacy",
    "yuanbao_app_verified",
    "tencent_wsa_search",
    "yuanbao_hy3_tokenhub",
    "manual_app_capture",
    "other_explicit"
  ],
  "response_status": [
    "answered",
    "refused",
    "timeout",
    "error",
    "unknown",
    "budget_blocked"
  ],
  "target_outcome": [
    "recommended",
    "conditionally_recommended",
    "candidate_only",
    "mentioned_only",
    "criteria_only",
    "refused_no_evidence",
    "refused_risk",
    "not_mentioned",
    "entity_ambiguous",
    "engine_error"
  ],
  "legacy_outcome_mapping": {
    "explicit_recommendation": "recommended",
    "conditional_recommendation": "conditionally_recommended",
    "candidate_only": "candidate_only",
    "mentioned_only": "mentioned_only",
    "not_mentioned": "not_mentioned",
    "refused": "split_by_reason_into_refused_no_evidence_or_refused_risk",
    "unknown": "split_by_evidence_into_entity_ambiguous_or_engine_error"
  },
  "event_processing_state": [
    "pending",
    "processing",
    "pending_review",
    "promoted",
    "private_only",
    "rejected",
    "withdrawn",
    "error"
  ],
  "entity_state": [
    "confirmed_mention",
    "confirmed_non_mention",
    "ambiguous",
    "unknown",
    "refused",
    "provider_error"
  ],
  "stability": [
    "stable",
    "watch",
    "insufficient",
    "shifted"
  ],
  "envelope_fields": [
    {"name": "schema_version", "type": "literal:geo-observation-v1", "nullable": false, "semantic": "contract schema"},
    {"name": "request_id", "type": "string", "nullable": false, "semantic": "caller-stable idempotency key"},
    {"name": "source_kind", "type": "enum:source_kind", "nullable": false, "semantic": "source API vocabulary mapped to source_type"},
    {"name": "source_ref", "type": "string", "nullable": false, "semantic": "source-owned stable reference"},
    {"name": "owner_user_id", "type": "integer", "nullable": true, "semantic": "private processing only"},
    {"name": "brand_id", "type": "integer", "nullable": true, "semantic": "private processing only"},
    {"name": "industry_key", "type": "string", "nullable": true, "semantic": "normalized industry key"},
    {"name": "question_text", "type": "string", "nullable": false, "semantic": "user-facing canonical question before provider rendering"},
    {"name": "question_hash", "type": "sha256", "nullable": false, "semantic": "hash of normalized question_text"},
    {"name": "query_kind", "type": "enum:branded|non_branded|comparative|verification", "nullable": false, "semantic": "query family"},
    {"name": "platform_key", "type": "string", "nullable": false, "semantic": "product label"},
    {"name": "provider_key", "type": "string", "nullable": false, "semantic": "actual API provider"},
    {"name": "model_key", "type": "string", "nullable": false, "semantic": "actual model or endpoint"},
    {"name": "model_revision", "type": "string", "nullable": true, "semantic": "provider-reported revision only"},
    {"name": "search_provider", "type": "string", "nullable": true, "semantic": "actual search provider when separate"},
    {"name": "surface_key", "type": "enum:surface_keys", "nullable": false, "semantic": "honest invocation surface"},
    {"name": "search_mode", "type": "string", "nullable": true, "semantic": "native, external, or no-search mode"},
    {"name": "search_enabled", "type": "boolean", "nullable": true, "semantic": "whether search was enabled; null means provider did not expose it"},
    {"name": "search_queries", "type": "array<SearchQueryEvidence>", "nullable": true, "semantic": "provider-returned grounding or fanout queries; never inferred"},
    {"name": "country_code", "type": "string", "nullable": false, "semantic": "ISO country code"},
    {"name": "region_key", "type": "string", "nullable": true, "semantic": "normalized region"},
    {"name": "session_mode", "type": "enum:clean|anonymous|accounted|unknown", "nullable": false, "semantic": "session contamination mode"},
    {"name": "run_index", "type": "integer", "nullable": false, "semantic": "repeat sample index"},
    {"name": "prompt_text", "type": "string", "nullable": false, "semantic": "exact provider-rendered prompt; may differ from question_text because of system framing"},
    {"name": "answer_text", "type": "string", "nullable": false, "semantic": "private raw answer"},
    {"name": "answer_hash", "type": "sha256", "nullable": false, "semantic": "raw answer hash"},
    {"name": "response_status", "type": "enum:response_status", "nullable": false, "semantic": "transport and response state"},
    {"name": "citations", "type": "array<CitationEvidence>", "nullable": false, "semantic": "explicit citations only"},
    {"name": "usage", "type": "UsageEvidence", "nullable": false, "semantic": "tokens and integer micro-cost"},
    {"name": "latency_ms", "type": "integer", "nullable": false, "semantic": "end-to-end adapter latency"},
    {"name": "retry_of_request_id", "type": "string", "nullable": true, "semantic": "transport retry parent without changing business request id"},
    {"name": "provider_trace_id", "type": "string", "nullable": true, "semantic": "private provider trace"},
    {"name": "observed_at", "type": "RFC3339", "nullable": false, "semantic": "actual observation time"}
  ],
  "search_query_evidence_fields": [
    {"name": "text", "type": "string", "nullable": false},
    {"name": "kind", "type": "string", "nullable": true},
    {"name": "rank", "type": "integer", "nullable": true},
    {"name": "provider_returned", "type": "literal:true", "nullable": false}
  ],
  "policy_schema": {
    "owner": "AI-2",
    "writable_fields": [
      {"name": "policy_version", "type": "string", "nullable": false},
      {"name": "platforms", "type": "array<PlatformPolicyV1>", "nullable": false},
      {"name": "source_base_weights_bps", "type": "SourceBaseWeightsV1", "nullable": false},
      {"name": "sampling_budget", "type": "SamplingBudgetV1", "nullable": false},
      {"name": "max_single_brand_share_bps", "type": "integer", "nullable": false, "constraint": "0..10000"},
      {"name": "public_min_independent_brands", "type": "integer", "nullable": false, "constraint": ">=3"},
      {"name": "public_min_source_types", "type": "integer", "nullable": false, "constraint": ">=2"},
      {"name": "retention_days", "type": "integer", "nullable": false, "constraint": ">0"},
      {"name": "anomaly_confirmation_numerator", "type": "integer", "nullable": false, "constraint": ">0"},
      {"name": "anomaly_confirmation_denominator", "type": "integer", "nullable": false, "constraint": ">=numerator"},
      {"name": "feature_flags", "type": "ObservationFeatureFlagsV1", "nullable": false}
    ],
    "platform_policy_fields": [
      {"name": "platform_key", "type": "string", "nullable": false},
      {"name": "enabled", "type": "boolean", "nullable": false},
      {"name": "base_weight_bps", "type": "integer", "nullable": false, "constraint": "0..10000"},
      {"name": "surface_key", "type": "enum:surface_keys", "nullable": true, "semantic": "required when enabled; nullable for legacy read-only catalog rows"},
      {"name": "legacy_read_only", "type": "boolean", "nullable": false}
    ],
    "source_base_weight_fields": [
      {"name": "research", "type": "integer", "constraint": "0..10000"},
      {"name": "paid_diagnosis", "type": "integer", "constraint": "0..10000"},
      {"name": "monitoring", "type": "integer", "constraint": "0..10000"}
    ],
    "sampling_budget_fields": [
      {"name": "max_calls_per_round", "type": "integer", "constraint": ">0"},
      {"name": "max_calls_per_day", "type": "integer", "constraint": ">0"},
      {"name": "max_cost_micros_per_day", "type": "bigint", "constraint": ">0"},
      {"name": "max_retry_calls_per_request", "type": "integer", "constraint": ">=0"}
    ],
    "feature_flag_fields": [
      {"name": "ingest_enabled", "type": "boolean"},
      {"name": "promotion_enabled", "type": "boolean"},
      {"name": "aggregation_enabled", "type": "boolean"},
      {"name": "product_enabled", "type": "boolean"}
    ],
    "checks": [
      "platform_key unique",
      "enabled platform requires non-null surface_key and positive base_weight_bps",
      "at least one non-legacy platform enabled",
      "platform base weights sum to 10000 across the full catalog",
      "runtime entitlement filtering is followed by deterministic renormalization to 10000"
    ],
    "write_contract": "expected_policy_version + reason + request_id; CAS 409; env override 423; data+version+audit one transaction",
    "runtime_readiness_is_writable": false
  },
  "platform_health_fields": [
    {"name": "platform_key", "type": "string", "nullable": false},
    {"name": "provider_key", "type": "string", "nullable": false},
    {"name": "model_key", "type": "string", "nullable": false},
    {"name": "surface_key", "type": "enum:surface_keys", "nullable": false},
    {"name": "status", "type": "enum:healthy|degraded|unavailable|unknown", "nullable": false},
    {"name": "checked_at", "type": "RFC3339", "nullable": false},
    {"name": "latency_ms", "type": "integer", "nullable": true},
    {"name": "model_revision", "type": "string", "nullable": true},
    {"name": "error_code", "type": "string", "nullable": true}
  ],
  "aggregate_schema": {
    "table": "geo_observation_aggregates",
    "ownership": {
      "migration_and_readiness": "AI-2",
      "repository_formula_writer_and_product_api": "AI-3"
    },
    "fields": [
      {"name": "aggregate_id", "type": "bigserial", "nullable": false, "constraint": "primary_key"},
      {"name": "aggregate_key", "type": "char(64)", "nullable": false, "constraint": "unique"},
      {"name": "contract_version", "type": "text", "nullable": false},
      {"name": "aggregation_version", "type": "text", "nullable": false},
      {"name": "metric_version", "type": "text", "nullable": false},
      {"name": "policy_version", "type": "text", "nullable": false},
      {"name": "scope_type", "type": "enum:private_brand|public_industry|admin_shadow", "nullable": false},
      {"name": "owner_user_id", "type": "bigint", "nullable": true, "semantic": "private_brand only; never public DTO"},
      {"name": "brand_id", "type": "bigint", "nullable": true, "semantic": "private_brand only; never public DTO"},
      {"name": "industry_key", "type": "text", "nullable": false},
      {"name": "bucket_granularity", "type": "enum:day|week|month", "nullable": false},
      {"name": "bucket_start", "type": "date", "nullable": false},
      {"name": "bucket_end", "type": "date", "nullable": false},
      {"name": "prompt_family_key", "type": "text", "nullable": true},
      {"name": "prompt_intent", "type": "text", "nullable": true},
      {"name": "is_branded_prompt", "type": "boolean", "nullable": true},
      {"name": "platform_key", "type": "text", "nullable": true},
      {"name": "surface_key", "type": "text", "nullable": true},
      {"name": "model_revision", "type": "text", "nullable": true},
      {"name": "search_enabled", "type": "boolean", "nullable": true},
      {"name": "source_type", "type": "text", "nullable": true},
      {"name": "search_query_theme", "type": "text", "nullable": true},
      {"name": "valid_observations", "type": "bigint", "nullable": false, "constraint": ">=0"},
      {"name": "independent_user_buckets", "type": "bigint", "nullable": false, "constraint": ">=0"},
      {"name": "independent_brand_buckets", "type": "bigint", "nullable": false, "constraint": ">=0"},
      {"name": "independent_source_types", "type": "bigint", "nullable": false, "constraint": ">=0"},
      {"name": "weighted_denominator_micros", "type": "bigint", "nullable": false, "constraint": ">=0"},
      {"name": "recommended_count", "type": "bigint", "nullable": false, "constraint": ">=0"},
      {"name": "conditionally_recommended_count", "type": "bigint", "nullable": false, "constraint": ">=0"},
      {"name": "candidate_only_count", "type": "bigint", "nullable": false, "constraint": ">=0"},
      {"name": "mentioned_only_count", "type": "bigint", "nullable": false, "constraint": ">=0"},
      {"name": "criteria_only_count", "type": "bigint", "nullable": false, "constraint": ">=0"},
      {"name": "refused_no_evidence_count", "type": "bigint", "nullable": false, "constraint": ">=0"},
      {"name": "refused_risk_count", "type": "bigint", "nullable": false, "constraint": ">=0"},
      {"name": "not_mentioned_count", "type": "bigint", "nullable": false, "constraint": ">=0"},
      {"name": "presence_rate_bps", "type": "integer", "nullable": false, "constraint": "0..10000"},
      {"name": "explicit_recommendation_rate_bps", "type": "integer", "nullable": false, "constraint": "0..10000"},
      {"name": "conditional_recommendation_rate_bps", "type": "integer", "nullable": false, "constraint": "0..10000"},
      {"name": "candidate_rate_bps", "type": "integer", "nullable": false, "constraint": "0..10000"},
      {"name": "mentioned_only_rate_bps", "type": "integer", "nullable": false, "constraint": "0..10000"},
      {"name": "criteria_only_rate_bps", "type": "integer", "nullable": false, "constraint": "0..10000"},
      {"name": "refusal_no_evidence_rate_bps", "type": "integer", "nullable": false, "constraint": "0..10000"},
      {"name": "refusal_risk_rate_bps", "type": "integer", "nullable": false, "constraint": "0..10000"},
      {"name": "not_mentioned_rate_bps", "type": "integer", "nullable": false, "constraint": "0..10000"},
      {"name": "refusal_rate_bps", "type": "integer", "nullable": false, "constraint": "0..10000"},
      {"name": "citation_rate_bps", "type": "integer", "nullable": false, "constraint": "0..10000"},
      {"name": "source_visibility_rate_bps", "type": "integer", "nullable": false, "constraint": "0..10000"},
      {"name": "evidence_coverage_rate_bps", "type": "integer", "nullable": false, "constraint": "0..10000"},
      {"name": "rank_top1_count", "type": "bigint", "nullable": false, "constraint": ">=0"},
      {"name": "rank_top3_count", "type": "bigint", "nullable": false, "constraint": ">=0"},
      {"name": "rank_top5_count", "type": "bigint", "nullable": false, "constraint": ">=0"},
      {"name": "rank_not_listed_count", "type": "bigint", "nullable": false, "constraint": ">=0"},
      {"name": "avg_position_milli", "type": "bigint", "nullable": true, "constraint": ">=0"},
      {"name": "share_of_voice_bps", "type": "integer", "nullable": true, "constraint": "0..10000"},
      {"name": "volatility_bps", "type": "integer", "nullable": false, "constraint": "0..10000"},
      {"name": "confirmed_change", "type": "boolean", "nullable": false},
      {"name": "trend_confidence_bps", "type": "integer", "nullable": false, "constraint": "0..10000"},
      {"name": "model_shift_index_bps", "type": "integer", "nullable": false, "constraint": "0..10000"},
      {"name": "stability_status", "type": "enum:stable|watch|insufficient|shifted", "nullable": false},
      {"name": "intrinsic_memory_rate_bps", "type": "integer", "nullable": true, "constraint": "0..10000"},
      {"name": "retrieval_selection_rate_bps", "type": "integer", "nullable": true, "constraint": "0..10000"},
      {"name": "input_watermark", "type": "timestamptz", "nullable": false},
      {"name": "computed_at", "type": "timestamptz", "nullable": false},
      {"name": "created_at", "type": "timestamptz", "nullable": false},
      {"name": "updated_at", "type": "timestamptz", "nullable": false}
    ],
    "table_checks": [
      "scope_type=private_brand requires owner_user_id and brand_id",
      "scope_type=public_industry requires owner_user_id and brand_id to be null",
      "bucket_end >= bucket_start",
      "all count and denominator fields are >= 0",
      "all *_bps fields are between 0 and 10000",
      "source_type is null or one of research_round|paid_diagnosis|recurring_monitoring",
      "stability_status is one of stable|watch|insufficient|shifted"
    ],
    "required_indexes": [
      "unique(aggregate_key)",
      "(scope_type,bucket_granularity,bucket_start)",
      "(owner_user_id,brand_id,bucket_start) where scope_type=private_brand",
      "(industry_key,bucket_granularity,bucket_start) where scope_type=public_industry"
    ],
    "public_dto_forbidden_fields": ["owner_user_id", "brand_id", "aggregate_key"],
    "eligibility": "join event and include only processing_state=promoted",
    "upsert": "AI-3 repository owns aggregate_key plus versions; same input watermark is idempotent"
  },
  "aggregation_eligibility": "join event and include only processing_state=promoted; withdrawn/private_only/rejected/error never aggregate",
  "weight_policy": "configured base weights may sum to 10000 across the full catalog; runtime weights are deterministically renormalized to 10000 across the enabled eligible set and recorded with policy_version and metric_version"
}
